#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/spark-remote-control"
readonly CONFIG_FILE="$CONFIG_DIR/env"
readonly PROJECT_CONFIG_DIR="$CONFIG_DIR/projects"
readonly USER_BIN_DIR="$HOME/.local/bin"
readonly USER_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
readonly VERSIONS_FILE="$REPO_DIR/config/versions.env"

say() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF'
sparkctl - manage the GX10 remote coding workstation

Usage:
  sparkctl setup
  sparkctl doctor
  sparkctl update
  sparkctl uninstall [--purge]
  sparkctl tool <install|update> opencode
  sparkctl auth opencode
  sparkctl service <enable|disable|start|stop|restart|status|logs> [opencode]
  sparkctl codex <status|start|stop|enable|disable|restart|logs|pair|adopt>
  sparkctl project add <name> <directory> [--spawn same-dir|worktree] [--capacity N]
  sparkctl project <enable|disable|start|stop|restart|status|logs|remove> <name>
  sparkctl project tmux <name>
  sparkctl project list
  sparkctl tailscale <status|plan>
  sparkctl bwrap <status|install|remove|test>

Typical first run:
  sparkctl setup
  sparkctl tool install opencode
  sparkctl auth opencode
  sparkctl doctor
  sparkctl bwrap install
  sparkctl service enable opencode
  sparkctl codex pair
  sparkctl codex enable
EOF
}

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    set +a
  fi
  export PATH="${SPARK_PATH:-$HOME/.local/bin:$HOME/.opencode/bin:/usr/local/bin:/usr/bin:/bin}"
}

load_versions() {
  [[ -f "$VERSIONS_FILE" ]] || die "version manifest missing: $VERSIONS_FILE"
  # shellcheck disable=SC1090
  source "$VERSIONS_FILE"
}

safe_link() {
  local source_path=$1 target_path=$2
  if [[ -L "$target_path" ]]; then
    [[ "$(readlink "$target_path")" == "$source_path" ]] || die "refusing to replace unrelated symlink: $target_path"
    return
  fi
  [[ ! -e "$target_path" ]] || die "refusing to replace existing file: $target_path"
  ln -s "$source_path" "$target_path"
}

setup() {
  install -d -m 0700 "$CONFIG_DIR" "$PROJECT_CONFIG_DIR"
  install -d -m 0755 "$USER_BIN_DIR" "$USER_UNIT_DIR"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    install -m 0600 "$REPO_DIR/config/spark.env.example" "$CONFIG_FILE"
    say "Created $CONFIG_FILE"
  else
    say "Kept existing $CONFIG_FILE"
  fi

  safe_link "$REPO_DIR/bin/sparkctl" "$USER_BIN_DIR/sparkctl"
  local unit
  for unit in "$REPO_DIR"/systemd/user/*.service; do
    safe_link "$unit" "$USER_UNIT_DIR/$(basename "$unit")"
  done
  systemctl --user daemon-reload
  say "Installed user-service links. Run: sparkctl doctor"
}

check_command() {
  local command_name=$1 requirement=${2:-optional}
  if have "$command_name"; then
    printf '  %-16s %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf '  %-16s %s\n' "$command_name" "missing ($requirement)"
  fi
}

doctor() {
  load_config
  say "Host"
  printf '  %-16s %s\n' kernel "$(uname -srmo)"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    printf '  %-16s %s\n' os "${PRETTY_NAME:-unknown}"
  fi

  say "Commands"
  check_command git required
  check_command systemctl required
  check_command bwrap "required for Codex sandbox"
  check_command tailscale "recommended for remote web access"
  check_command opencode "required for OpenCode service"
  check_command claude "optional remote-control service"
  check_command tmux "required for project tmux"
  check_command codex "required for Codex remote-control service"
  check_command docker "existing vLLM runtime"

  say "Configuration"
  [[ -f "$CONFIG_FILE" ]] && say "  config           $CONFIG_FILE" || say "  config           missing; run sparkctl setup"
  [[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]] && say "  opencode-auth    password configured" || say "  opencode-auth    password missing"
  [[ -d "${SPARK_PROJECTS_DIR:-$HOME/code}" ]] && say "  projects-root    ${SPARK_PROJECTS_DIR:-$HOME/code}" || say "  projects-root    missing: ${SPARK_PROJECTS_DIR:-$HOME/code}"
  if systemctl --user show-environment >/dev/null 2>&1; then
    say "  systemd-user     available"
  else
    say "  systemd-user     unavailable"
  fi

  say "Bubblewrap"
  "$REPO_DIR/scripts/bwrap-apparmor.sh" status || true

  say "Tailscale"
  if have tailscale; then
    tailscale serve status || true
  else
    say "  unavailable"
  fi

  say "Existing vLLM"
  if have docker && docker inspect vllm-server >/dev/null 2>&1; then
    docker inspect --format '  container={{.State.Status}} restart={{.HostConfig.RestartPolicy.Name}} ports={{json .HostConfig.PortBindings}}' vllm-server
    if have curl && curl -fsS --max-time 3 "${SPARK_VLLM_URL:-http://127.0.0.1:8000/v1}/models" >/dev/null; then
      say "  endpoint         healthy"
    else
      say "  endpoint         unavailable"
    fi
  else
    say "  container        not found"
  fi

  say "Codex remote control"
  codex_status_lines

  say "Managed services"
  systemctl --user --no-pager --full status spark-opencode.service || true
}

tool_action() {
  local action=${1:-} name=${2:-}
  [[ "$action" == install || "$action" == update ]] || die "tool action must be install or update"
  [[ "$name" == opencode ]] || die "only the opencode tool is currently managed"
  load_versions
  have npm || die "npm is required to install OpenCode"
  local spec="${SPARK_OPENCODE_NPM_PACKAGE}@${SPARK_OPENCODE_VERSION}"
  say "Installing $spec into $HOME/.local"
  npm install --global --prefix "$HOME/.local" "$spec"
  "$HOME/.local/bin/opencode" --version
}

auth_action() {
  [[ "${1:-}" == opencode ]] || die "usage: sparkctl auth opencode"
  load_config
  have opencode || die "install OpenCode first: sparkctl tool install opencode"
  exec opencode auth login
}

service_action() {
  local action=${1:-status} name=${2:-opencode}
  [[ "$name" == opencode ]] || die "unknown managed service: $name"
  local unit=spark-opencode.service
  case "$action" in
    enable) systemctl --user enable --now "$unit" ;;
    disable) systemctl --user disable --now "$unit" ;;
    start|stop|restart) systemctl --user "$action" "$unit" ;;
    status) systemctl --user --no-pager --full status "$unit" ;;
    logs) exec journalctl --user -u "$unit" -f ;;
    *) die "unknown service action: $action" ;;
  esac
}

codex_home() {
  printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
}

# Shells out to `codex app-server daemon version` and parses its stdout
# rather than reaching into process tables, so this stays testable with a
# fake `codex` on SPARK_PATH. Echoes one of: running, stopped, unknown.
codex_daemon_status() {
  have codex || { printf 'unknown\n'; return; }
  local output
  output=$(codex app-server daemon version 2>/dev/null) || { printf 'stopped\n'; return; }
  local status
  status=$(printf '%s' "$output" | sed -n 's/.*"status" *: *"\([^"]*\)".*/\1/p')
  case "$status" in
    running) printf 'running\n' ;;
    '') printf 'unknown\n' ;;
    *) printf 'stopped\n' ;;
  esac
}

# Best-effort appServerVersion from the same probe; empty when unavailable.
codex_daemon_version() {
  have codex || return 0
  codex app-server daemon version 2>/dev/null \
    | sed -n 's/.*"appServerVersion" *: *"\([^"]*\)".*/\1/p'
}

# The three-line report shared by `sparkctl codex status` and `sparkctl
# doctor`, so the two can never drift apart.
codex_status_lines() {
  local unit=spark-codex-remote.service
  local daemon
  daemon=$(codex_daemon_status)
  if [[ "$daemon" == running ]]; then
    local version
    version=$(codex_daemon_version)
    [[ -z "$version" ]] || daemon="running ($version)"
  fi
  printf '  %-16s %s\n' daemon "$daemon"
  printf '  %-16s %s\n' remote-control "$(codex_remote_control_enabled)"
  printf '  %-16s %s\n' unit "enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null || echo disabled) active=$(systemctl --user is-active "$unit" 2>/dev/null || echo inactive)"
}

# Reads $CODEX_HOME/app-server-daemon/settings.json. Echoes one of: enabled,
# disabled, unknown.
codex_remote_control_enabled() {
  local settings_file
  settings_file="$(codex_home)/app-server-daemon/settings.json"
  [[ -f "$settings_file" ]] || { printf 'unknown\n'; return; }
  local value
  value=$(sed -n 's/.*"remoteControlEnabled" *: *\(true\|false\).*/\1/p' "$settings_file")
  case "$value" in
    true) printf 'enabled\n' ;;
    false) printf 'disabled\n' ;;
    *) printf 'unknown\n' ;;
  esac
}

# Refuses to hand off to systemd when a Codex daemon is already running but
# was not started by our unit: it is likely serving live sessions started by
# hand or by a `codex` TUI, and taking it over silently would be surprising.
codex_guard_running_daemon() {
  local unit=spark-codex-remote.service
  if [[ "$(codex_daemon_status)" == running ]] && ! systemctl --user is-active --quiet "$unit"; then
    die "a Codex daemon is already running outside $unit; run: sparkctl codex adopt"
  fi
}

codex_confirm_adopt() {
  [[ "${SPARK_ASSUME_YES:-}" == 1 ]] && return
  [[ -t 0 ]] || die "refusing to adopt a running Codex daemon without confirmation; rerun on a TTY or set SPARK_ASSUME_YES=1"
  local reply
  read -r -p "Stop the running Codex daemon and restart it under spark-codex-remote.service? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || die "adoption cancelled"
}

codex_action() {
  local action=${1:-status}
  load_config
  local unit=spark-codex-remote.service
  case "$action" in
    status) codex_status_lines ;;
    start)
      codex_guard_running_daemon
      systemctl --user start "$unit"
      ;;
    enable)
      codex_guard_running_daemon
      systemctl --user enable --now "$unit"
      ;;
    stop) systemctl --user stop "$unit" ;;
    disable) systemctl --user disable --now "$unit" ;;
    restart)
      codex_guard_running_daemon
      systemctl --user restart "$unit"
      ;;
    logs) exec journalctl --user -u "$unit" -f ;;
    pair)
      have codex || die "codex is not installed or not on SPARK_PATH"
      exec codex remote-control pair
      ;;
    adopt)
      have codex || die "codex is not installed or not on SPARK_PATH"
      codex_confirm_adopt
      codex remote-control stop
      systemctl --user enable --now "$unit"
      ;;
    *) die "unknown codex action: $action" ;;
  esac
}

validate_project_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "project name must contain only letters, numbers, dot, underscore, and dash"
}

load_project_config() {
  local name=$1
  local project_file="$PROJECT_CONFIG_DIR/$name.env"
  [[ -f "$project_file" ]] || die "project configuration missing: $project_file"
  set -a
  # shellcheck disable=SC1090
  source "$project_file"
  set +a
  [[ -d "${CLAUDE_PROJECT_DIR:-}" ]] || die "CLAUDE_PROJECT_DIR is invalid"
}

project_add() {
  [[ $# -ge 2 ]] || die "usage: sparkctl project add <name> <directory> [--spawn same-dir|worktree] [--capacity N]"
  local name=$1 project_dir=$2
  shift 2
  local spawn_mode=same-dir capacity=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --spawn)
        [[ $# -ge 2 ]] || die "--spawn requires a value"
        spawn_mode=$2
        shift 2
        ;;
      --capacity)
        [[ $# -ge 2 ]] || die "--capacity requires a value"
        capacity=$2
        shift 2
        ;;
      *) die "unknown project add option: $1" ;;
    esac
  done
  validate_project_name "$name"
  case "$spawn_mode" in
    same-dir|worktree) ;;
    session) die "--spawn session is not supported by the persistent service; use: sparkctl project tmux $name" ;;
    *) die "--spawn must be same-dir or worktree" ;;
  esac
  if [[ -n "$capacity" ]]; then
    [[ "$capacity" =~ ^[1-9][0-9]*$ ]] || die "--capacity must be a positive integer"
  fi
  project_dir=$(realpath "$project_dir")
  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"
  if [[ "$spawn_mode" == worktree ]]; then
    git -C "$project_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "--spawn worktree requires $project_dir to be a git repository"
  fi
  install -d -m 0700 "$PROJECT_CONFIG_DIR"
  local target="$PROJECT_CONFIG_DIR/$name.env"
  [[ ! -e "$target" ]] || die "project already exists: $name"
  {
    printf 'CLAUDE_PROJECT_DIR=%q\n' "$project_dir"
    printf 'CLAUDE_PERMISSION_MODE=%q\n' auto
    printf 'CLAUDE_SPAWN_MODE=%q\n' "$spawn_mode"
    [[ -z "$capacity" ]] || printf 'CLAUDE_CAPACITY=%q\n' "$capacity"
  } >"$target"
  chmod 0600 "$target"
  say "Added $name -> $project_dir (spawn=$spawn_mode${capacity:+, capacity=$capacity})"
  say "Start its multi-session service with: sparkctl project enable $name"
  say "Or open one interactive session with: sparkctl project tmux $name"
}

project_tmux() {
  local name=$1
  load_config
  load_project_config "$name"
  have tmux || die "tmux is required for project tmux"
  have claude || die "claude is not installed or not on SPARK_PATH"

  local unit="spark-claude-remote@$name.service"
  if systemctl --user is-active --quiet "$unit"; then
    die "$unit is active; stop it before using: sparkctl project tmux $name"
  fi

  local session_name="spark-claude-$name"
  if tmux has-session -t "=$session_name" >/dev/null 2>&1; then
    if [[ -n "${TMUX:-}" ]]; then
      exec tmux switch-client -t "=$session_name"
    fi
    exec tmux attach-session -t "=$session_name"
  fi

  local runner_command
  printf -v runner_command '%q ' "$REPO_DIR/bin/sparkctl" internal run-claude-tmux "$name"
  runner_command=${runner_command% }
  if [[ -n "${TMUX:-}" ]]; then
    tmux new-session -d -s "$session_name" -c "$CLAUDE_PROJECT_DIR" "$runner_command"
    exec tmux switch-client -t "=$session_name"
  fi
  exec tmux new-session -s "$session_name" -c "$CLAUDE_PROJECT_DIR" "$runner_command"
}

require_project_tmux_inactive() {
  local name=$1 session_name="spark-claude-$1"
  if have tmux && tmux has-session -t "=$session_name" >/dev/null 2>&1; then
    die "$session_name is active; exit it before starting the persistent service for $name"
  fi
}

project_action() {
  local action=${1:-list} name=${2:-}
  if [[ "$action" == add ]]; then
    project_add "${@:2}"
    return
  fi
  if [[ "$action" == list ]]; then
    if [[ -d "$PROJECT_CONFIG_DIR" ]]; then
      local file
      for file in "$PROJECT_CONFIG_DIR"/*.env; do
        [[ -e "$file" ]] || continue
        printf '%s\n' "$(basename "$file" .env)"
      done
    fi
    return
  fi
  [[ -n "$name" ]] || die "project name required"
  validate_project_name "$name"
  local project_file="$PROJECT_CONFIG_DIR/$name.env"
  [[ -f "$project_file" ]] || die "unknown project: $name"
  local unit="spark-claude-remote@$name.service"
  case "$action" in
    tmux) project_tmux "$name" ;;
    enable)
      require_project_tmux_inactive "$name"
      systemctl --user enable --now "$unit"
      ;;
    disable) systemctl --user disable --now "$unit" ;;
    start|restart)
      require_project_tmux_inactive "$name"
      systemctl --user "$action" "$unit"
      ;;
    stop) systemctl --user stop "$unit" ;;
    status) systemctl --user --no-pager --full status "$unit" ;;
    logs) exec journalctl --user -u "$unit" -f ;;
    remove)
      systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
      mv "$project_file" "$project_file.disabled-$(date +%Y%m%d%H%M%S)"
      say "Disabled and archived project configuration: $name"
      ;;
    *) die "unknown project action: $action" ;;
  esac
}

tailscale_action() {
  case "${1:-status}" in
    status)
      have tailscale || die "tailscale is not installed"
      tailscale serve status
      ;;
    plan)
      cat <<'EOF'
The GX10 already serves HTTPS / on the default tailnet port. A non-destructive
starting point for OpenCode is a separate tailnet HTTPS port:

  sudo tailscale serve --bg --https=4443 http://127.0.0.1:4096

Review `tailscale serve status` before and after. Do not run `tailscale serve
reset`; it would remove the existing Stremio route.
EOF
      ;;
    *) die "usage: sparkctl tailscale <status|plan>" ;;
  esac
}

run_opencode() {
  load_config
  have opencode || die "opencode is not installed or not on SPARK_PATH"
  [[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]] || die "set OPENCODE_SERVER_PASSWORD in $CONFIG_FILE"
  local host=${SPARK_OPENCODE_HOST:-127.0.0.1}
  local port=${SPARK_OPENCODE_PORT:-4096}
  local projects_dir=${SPARK_PROJECTS_DIR:-$HOME/code}
  [[ "$host" == 127.0.0.1 || "$host" == ::1 || "$host" == localhost ]] || die "OpenCode must bind to loopback, not $host"
  [[ -d "$projects_dir" ]] || die "projects directory does not exist: $projects_dir"
  cd "$projects_dir"
  exec opencode web --hostname "$host" --port "$port"
}

run_claude() {
  local name=${1:-}
  validate_project_name "$name"
  load_config
  load_project_config "$name"
  have claude || die "claude is not installed or not on SPARK_PATH"
  cd "$CLAUDE_PROJECT_DIR"
  local -a args=(remote-control --permission-mode "${CLAUDE_PERMISSION_MODE:-auto}")
  # Only pass --spawn/--capacity when the project asked for something other
  # than the CLI's own defaults, so projects configured before these settings
  # existed keep behaving exactly as before.
  case "${CLAUDE_SPAWN_MODE:-same-dir}" in
    same-dir) ;;
    worktree) args+=(--spawn worktree) ;;
    session) die "CLAUDE_SPAWN_MODE=session is not supported by the persistent service; use: sparkctl project tmux $name" ;;
    *) die "CLAUDE_SPAWN_MODE must be same-dir or worktree" ;;
  esac
  if [[ -n "${CLAUDE_CAPACITY:-}" ]]; then
    args+=(--capacity "$CLAUDE_CAPACITY")
  fi
  exec claude "${args[@]}"
}

run_claude_tmux() {
  local name=${1:-}
  validate_project_name "$name"
  load_config
  load_project_config "$name"
  have claude || die "claude is not installed or not on SPARK_PATH"
  cd "$CLAUDE_PROJECT_DIR"

  local status=0
  claude --permission-mode "${CLAUDE_PERMISSION_MODE:-auto}" --remote-control "$name" || status=$?
  say "Claude exited with status $status; the tmux session remains open."
  say "Resume the latest conversation with: claude --continue"
  say "To choose a conversation instead, run: claude --resume"
  say "Then enable remote access inside Claude with: /remote-control"

  local interactive_shell=${SHELL:-/bin/bash}
  [[ -x "$interactive_shell" ]] || die "interactive shell is not executable: $interactive_shell"
  exec "$interactive_shell" -l
}

run_codex_start() {
  load_config
  have codex || die "codex is not installed or not on SPARK_PATH"
  exec codex remote-control start
}

run_codex_stop() {
  load_config
  have codex || die "codex is not installed or not on SPARK_PATH"
  exec codex remote-control stop
}

update_repo() {
  have git || die "git is required"
  [[ -z "$(git -C "$REPO_DIR" status --porcelain)" ]] || die "repository has uncommitted changes; commit or stash them before updating"
  git -C "$REPO_DIR" pull --ff-only
  setup
  "$REPO_DIR/scripts/check.sh"
}

remove_managed_link() {
  local target=$1 source=$2
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    rm "$target"
  fi
}

uninstall_repo() {
  local purge=${1:-}
  systemctl --user disable --now spark-opencode.service >/dev/null 2>&1 || true
  systemctl --user disable --now spark-codex-remote.service >/dev/null 2>&1 || true
  local project_file name
  if [[ -d "$PROJECT_CONFIG_DIR" ]]; then
    for project_file in "$PROJECT_CONFIG_DIR"/*.env; do
      [[ -e "$project_file" ]] || continue
      name=$(basename "$project_file" .env)
      systemctl --user disable --now "spark-claude-remote@$name.service" >/dev/null 2>&1 || true
    done
  fi
  remove_managed_link "$USER_BIN_DIR/sparkctl" "$REPO_DIR/bin/sparkctl"
  local unit
  for unit in "$REPO_DIR"/systemd/user/*.service; do
    remove_managed_link "$USER_UNIT_DIR/$(basename "$unit")" "$unit"
  done
  systemctl --user daemon-reload
  if [[ "$purge" == --purge ]]; then
    local archive="$CONFIG_DIR.disabled-$(date +%Y%m%d%H%M%S)"
    [[ ! -e "$CONFIG_DIR" ]] || mv "$CONFIG_DIR" "$archive"
    say "Configuration archived at $archive"
  else
    say "Configuration preserved at $CONFIG_DIR"
  fi
  say "Removed managed service and command links. The repository was preserved."
}

main() {
  local command=${1:-help}
  shift || true
  case "$command" in
    help|-h|--help) usage ;;
    setup|install) setup ;;
    doctor) doctor ;;
    update) update_repo ;;
    uninstall) uninstall_repo "$@" ;;
    tool) tool_action "$@" ;;
    auth) auth_action "$@" ;;
    service) service_action "$@" ;;
    codex) codex_action "$@" ;;
    project) project_action "$@" ;;
    tailscale) tailscale_action "$@" ;;
    bwrap) exec "$REPO_DIR/scripts/bwrap-apparmor.sh" "$@" ;;
    internal)
      case "${1:-}" in
        run-opencode) run_opencode ;;
        run-claude) run_claude "${2:-}" ;;
        run-claude-tmux) run_claude_tmux "${2:-}" ;;
        run-codex-start) run_codex_start ;;
        run-codex-stop) run_codex_stop ;;
        *) die "unknown internal command: ${1:-}" ;;
      esac
      ;;
    *) die "unknown command: $command (run 'sparkctl help')" ;;
  esac
}

main "$@"
