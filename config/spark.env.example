# Copied to ~/.config/spark-remote-control/env by `sparkctl setup`.
# This file is sourced by Bash. Keep real credentials only in the installed copy.

SPARK_PROJECTS_DIR="$HOME/code"

SPARK_OPENCODE_HOST=127.0.0.1
SPARK_OPENCODE_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
# Generate with: openssl rand -base64 36
OPENCODE_SERVER_PASSWORD=

# Existing Docker-managed vLLM endpoint. This toolkit monitors but does not
# recreate the container.
SPARK_VLLM_URL=http://127.0.0.1:8000/v1

# User-installed binaries used by systemd services.
SPARK_PATH="$HOME/.local/bin:$HOME/.opencode/bin:/usr/local/bin:/usr/bin:/bin"

